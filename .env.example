# =============================================================================
# CONATACOCH - Variables de entorno (Fase 1)
# Copiar a .env  ->  cp .env.example .env
# NUNCA versionar el archivo .env con secretos reales.
# =============================================================================

# -----------------------------------------------------------------------------
# Identidad de la aplicacion
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=conatacoch
DJANGO_ENV=production
DEBUG=False
# Hosts separados por coma. Incluye siempre el dominio publico en produccion.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web_admin
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Clave Django (min. 50 caracteres aleatorios). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-django-en-produccion-000000000000000000000

# Clave de firma de los JWT (independiente de SECRET_KEY).
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esta-clave-jwt-en-produccion-000000000000000000000000
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Clave dedicada para cifrar OTP (opcional; si esta vacia se deriva de SECRET_KEY).
OTP_ENCRYPTION_KEY=

# Endurecimiento opcional en produccion con HTTPS:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Throttling y logs
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MySQL 8.0 (persistencia relacional, 3FN)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_conatacoch_2026
MYSQL_DATABASE=conatacoch
MYSQL_USER=conatacoch
MYSQL_PASSWORD=conatacoch_2026
MYSQL_HOST=db_mysql
MYSQL_PORT=3306
MYSQL_EXPOSED_PORT=3306

# Pool de conexiones de Django (segundos de reutilizacion por worker).
DB_CONN_MAX_AGE=600
DB_WAIT_RETRIES=30
DB_WAIT_DELAY=2

# Alternativa usada solo para pruebas locales sin Docker:
# DB_ENGINE=django.db.backends.sqlite3
# SQLITE_PATH=./db.sqlite3

# -----------------------------------------------------------------------------
# MongoDB Atlas - telemetria geoespacial (documentos GeoJSON)
# -----------------------------------------------------------------------------
# PRIORIDAD: si MONGO_ATLAS_URI tiene valor se usa Atlas con TLS.
# Si queda vacio, el backend cae al contenedor local "mongo_local"
# (levantar con: docker compose --profile mongo-local up -d).
# Formato Atlas:
#   mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_ATLAS_URI=
MONGO_LOCAL_URI=mongodb://mongo_local:27017
MONGO_LOCAL_EXPOSED_PORT=27017
MONGO_DB_NAME=telemetria_ubicacion
MONGO_COLLECTION=ubicaciones
MONGO_TTL_SECONDS=14400
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Carga inicial idempotente
# -----------------------------------------------------------------------------
SEED_ON_START=true
SEED_DATA_FILE=/app/data/recorridos_conatacoch_taxi_colectivo_2.json
SEED_TARIFA_URBANA=1000
SEED_TARIFA_RURAL=1500

# -----------------------------------------------------------------------------
# Servicios / escalabilidad
# -----------------------------------------------------------------------------
WEB_ADMIN_PORT=8080
BACKEND_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
